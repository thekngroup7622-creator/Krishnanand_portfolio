# Server-Side Email Delivery Configuration (Nodemailer SMTP)
# Add these securely in Vercel Dashboard -> Settings -> Environment Variables
#
# For Gmail SMTP:
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password under "App passwords": https://myaccount.google.com/apppasswords
#    (Select App: "Mail", Device: "Other (Portfolio Website)")
# 3. Enter your full Gmail address in SMTP_USER and the 16-character app password in SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=krishnanandcricketanalyst@gmail.com
SMTP_PASS=your-16-char-google-app-password
CONTACT_RECEIVER_EMAIL=krishnanandcricketanalyst@gmail.com
